<Window x:Class="LR1_3kyrs_NOVIKOVA_BAI24.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR1_3kyrs_NOVIKOVA_BAI24.View"
        mc:Ignorable="d"
        Title="Сотрудник" Height="320" Width="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="TextBoxDate" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Код:" Margin="10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="10" Text="{Binding Id}" IsEnabled="False"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Должность:" Margin="10"/>
        <ComboBox x:Name="CbRole" Grid.Row="1" Grid.Column="1" Margin="10" DisplayMemberPath="NameRole"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Фамилия:" Margin="10"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="10" Text="{Binding LastName}"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Имя:" Margin="10"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="10" Text="{Binding FirstName}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Дата рождения:" Margin="10"/>

        <!-- Текстовое поле для отображения даты (скрывается при фокусе) -->
        <TextBox x:Name="tbBirthday" Style="{StaticResource TextBoxDate}" Text="{Binding Birthday}" Grid.Row="4" Grid.Column="1" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,8,0,7" Width="130" IsVisibleChanged="tbBirthday_IsVisibleChanged" />

        <!-- Сам календарь (скрыт по умолчанию) -->
        <DatePicker x:Name="clBirthday" Visibility="Hidden" Grid.Row="4" Grid.Column="1" SelectedDate="{Binding Birthday, StringFormat={}{0:dd.MM.yyyy}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,8,0,7" Width="130" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Height="25" Width="100" Margin="10" Click="Save_Click"/>
            <Button Content="Отменить" Height="25" Width="100" Margin="10" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>